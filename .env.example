# Helios bridge — public env vars (inlined into the client bundle at build time)
#
# IMPORTANT: changes to PUBLIC_* vars require a REDEPLOY to take effect
# in the deployed bundle. Vite replaces these references at build time;
# updating them in the Vercel dashboard alone does NOT inject them into
# an already-deployed build.

# Base URL for HTTP + SSE endpoints exposed by the Helios bridge.
PUBLIC_HELIOS_API_URL=http://localhost:8080

# Base URL for WebSocket endpoints exposed by the Helios bridge.
PUBLIC_HELIOS_WS_URL=ws://localhost:8080

# Master switch for the live bridge. Set to "true" to consume the real
# Helios bridge; any other value (or unset) keeps the dashboard on
# mock data. THIS MUST BE "true" FOR THE DASHBOARD TO OPEN A WEBSOCKET.
PUBLIC_USE_LIVE_BRIDGE=false

# Optional: build-time bearer token. Used as a fallback when no token
# is present in localStorage. Set this in Vercel for environments
# where users are not expected to log in manually (e.g. a static demo
# deployment against a test bridge). The login page still wins when
# the user has typed a token in the browser.
PUBLIC_HELIOS_TOKEN=

# Optional: auth transport for WS / SSE. Default `query` appends
# ?token=... to the URL. The other options are reserved for future
# transports (Sec-WebSocket-Protocol, cookie) and are not yet wired.
PUBLIC_HELIOS_AUTH_TRANSPORT=query
